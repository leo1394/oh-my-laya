{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-laya.local/contracts/feedback.schema.json",
  "title": "Laya feedback event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "event_id", "decision_id", "attempt_ref", "kind", "source", "payload"],
  "properties": {
    "protocol_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt_ref": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["assignment", "test", "review", "outcome", "user_choice", "usage", "run_manifest"]},
    "source": {"$ref": "#/$defs/source"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "assignment"}}},
      "then": {
        "required": ["attempt_ref"],
        "properties": {"payload": {"$ref": "#/$defs/assignmentPayload"}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "test"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/testPayload"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "review"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/reviewPayload"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "outcome"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/outcomePayload"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "user_choice"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/userChoicePayload"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "usage"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/usagePayload"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "run_manifest"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/runManifestPayload"}}}
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "role", "actor_type"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "actor_type": {"const": "agent"}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "dimension", "value", "reason", "evidence_refs", "phase", "source_sequence", "observed_at"],
      "properties": {
        "rubric_version": {"const": "laya-feedback-v1"},
        "dimension": {"enum": ["judgment_quality", "model_fit", "outcome_quality"]},
        "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "phase": {"enum": ["initial", "revision"]},
        "source_sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 128},
        "supersedes_event_id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {"if": {"properties": {"phase": {"const": "revision"}}}, "then": {"required": ["supersedes_event_id"]}},
        {"if": {"properties": {"phase": {"const": "initial"}}}, "then": {"not": {"required": ["supersedes_event_id"]}}}
      ]
    },
    "common": {
      "scores": {"type": "array", "items": {"$ref": "#/$defs/score"}},
      "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
      "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "verified", "observed_at"],
      "properties": {
        "source": {"enum": ["laya", "user", "policy", "spawn_request", "host"]},
        "verified": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 128},
        "reference": {"type": ["string", "null"], "maxLength": 1024},
        "provider": {"type": ["string", "null"], "maxLength": 256},
        "model_revision": {"type": ["string", "null"], "maxLength": 256},
        "catalog_version": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "assignmentPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "model_observation"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "model_observation": {"$ref": "#/$defs/observation"}
      }
    },
    "effectivePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "model_observation"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "model_observation": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "verified", "observed_at"],
          "properties": {
            "source": {"const": "host"}, "verified": {"const": true},
            "observed_at": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 128},
            "reference": {"type": ["string", "null"], "maxLength": 1024},
            "provider": {"type": ["string", "null"], "maxLength": 256},
            "model_revision": {"type": ["string", "null"], "maxLength": 256},
            "catalog_version": {"type": ["string", "null"], "maxLength": 256}
          }
        }
      }
    },
    "assignmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "selected", "requested", "effective", "reason", "evidence_refs"],
      "properties": {
        "execution": {"$ref": "#/$defs/dispatchReceipt"},
        "recommended": {"oneOf": [{"$ref": "#/$defs/assignmentPair"}, {"type": "null"}]},
        "selected": {"oneOf": [{"$ref": "#/$defs/assignmentPair"}, {"type": "null"}]},
        "requested": {"oneOf": [{"$ref": "#/$defs/assignmentPair"}, {"type": "null"}]},
        "effective": {"oneOf": [{"$ref": "#/$defs/effectivePair"}, {"type": "null"}]},
        "parent_attempt_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "change_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "mixed_configuration": {"type": "boolean"},
        "environment": {"type": ["object", "null"]},
        "scores": {"$ref": "#/$defs/common/scores"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "testPayload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "result": {"enum": ["pass", "fail", "unknown"]}, "status": {"enum": ["pass", "fail", "unknown"]},
        "scope": {"type": "string", "minLength": 1, "maxLength": 8192}, "test_scope": {"type": "string", "minLength": 1, "maxLength": 8192},
        "code_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}, "summary": {"type": "string", "minLength": 1, "maxLength": 8192},
        "scores": {"$ref": "#/$defs/common/scores"}, "reason": {"$ref": "#/$defs/common/reason"}, "evidence_refs": {"$ref": "#/$defs/common/evidence_refs"}
      }
    },
    "reviewPayload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["approved", "changes_requested", "rejected", "blocked", "disagree", "no_findings", "ok", "unknown"]},
        "status": {"enum": ["approved", "changes_requested", "rejected", "blocked", "disagree", "no_findings", "ok", "unknown"]},
        "disposition": {"enum": ["approved", "changes_requested", "rejected", "blocked", "disagree", "no_findings", "ok", "unknown"]},
        "proposed_labels": {"type": "object", "additionalProperties": false, "properties": {"complexity": {"enum": ["low", "medium", "high"]}, "risk": {"enum": ["low", "medium", "high"]}, "certainty": {"enum": ["clear", "uncertain"]}}},
        "summary": {"type": "string", "minLength": 1, "maxLength": 8192},
        "scores": {"$ref": "#/$defs/common/scores"}, "reason": {"$ref": "#/$defs/common/reason"}, "evidence_refs": {"$ref": "#/$defs/common/evidence_refs"}
      }
    },
    "outcomePayload": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {"if": {"required": ["execution"]}, "then": {"anyOf": [{"required": ["outcome"]}, {"required": ["status"]}]}},
        {"if": {"required": ["execution"], "properties": {"execution": {"properties": {"result": {"const": "success"}}}}}, "then": {"properties": {"outcome": {"const": "success"}, "status": {"const": "success"}}}},
        {"if": {"required": ["execution"], "properties": {"execution": {"properties": {"result": {"const": "failure"}}}}}, "then": {"properties": {"outcome": {"const": "failure"}, "status": {"const": "failure"}}}},
        {"if": {"required": ["execution"], "properties": {"execution": {"properties": {"result": {"const": "partial"}}}}}, "then": {"properties": {"outcome": {"const": "partial"}, "status": {"const": "partial"}}}},
        {"if": {"required": ["execution"], "properties": {"execution": {"properties": {"result": {"const": "cancelled"}}}}}, "then": {"properties": {"outcome": {"const": "cancelled"}, "status": {"const": "cancelled"}}}},
        {"if": {"required": ["execution"], "properties": {"execution": {"properties": {"result": {"const": "unknown"}}}}}, "then": {"properties": {"outcome": {"const": "unknown"}, "status": {"const": "unknown"}}}}
      ],
      "properties": {
        "execution": {"$ref": "#/$defs/attemptOutcome"},
        "outcome": {"enum": ["success", "failure", "partial", "cancelled", "unknown"]}, "status": {"enum": ["success", "failure", "partial", "cancelled", "unknown"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 8192}, "failure_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "scores": {"$ref": "#/$defs/common/scores"}, "reason": {"$ref": "#/$defs/common/reason"}, "evidence_refs": {"$ref": "#/$defs/common/evidence_refs"}
      }
    },
    "executionIdentity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "executionNullableReference": {"type": ["string", "null"], "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "executionEventReferences": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/executionIdentity"}},
    "dispatchReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "run_id", "stage_id", "ordinal", "policy_version", "enforcement", "role", "attempt_kind", "status", "native_execution_ref", "context_isolation", "context_evidence_ref", "input_size"],
      "properties": {
        "contract": {"const": "dispatch_receipt_v1"},
        "role": {"enum": ["orchestrator", "explorer", "worker", "tester", "researcher", "reviewer"], "description": "Execution role, distinct from the envelope's reporting source.role."},
        "run_id": {"$ref": "#/$defs/executionIdentity"}, "stage_id": {"$ref": "#/$defs/executionIdentity"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000, "description": "Observed ordinal; values above the automatic budget remain evidence, not permission."},
        "policy_version": {"const": "bounded-attempts-v1"}, "enforcement": {"const": "advisory"},
        "attempt_kind": {"enum": ["initial", "repair", "upgrade", "manual"]}, "status": {"enum": ["started", "failed", "unknown"]},
        "native_execution_ref": {"$ref": "#/$defs/executionNullableReference"},
        "context_isolation": {"enum": ["isolated", "unsupported", "unknown"]},
        "context_evidence_ref": {"$ref": "#/$defs/executionNullableReference"},
        "input_size": {
          "type": "object", "additionalProperties": false, "required": ["value", "unit", "source"],
          "properties": {
            "value": {"type": ["integer", "null"], "minimum": 0},
            "unit": {"enum": ["native_tokens", "bytes", "characters", "unknown"]},
            "source": {"$ref": "#/$defs/executionNullableReference"}
          },
          "allOf": [{"if": {"properties": {"value": {"type": "integer"}}}, "then": {"properties": {"unit": {"enum": ["native_tokens", "bytes", "characters"]}, "source": {"type": "string"}}}}]
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "started"}}}, "then": {"properties": {"native_execution_ref": {"type": "string"}}}},
        {"if": {"properties": {"context_isolation": {"const": "isolated"}}}, "then": {"properties": {"context_evidence_ref": {"type": "string"}}}}
      ]
    },
    "attemptOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "run_id", "stage_id", "ordinal", "policy_version", "enforcement", "dispatch_event_id", "result", "failure_class", "first_feedback_event_id", "test_event_ids", "review_event_ids", "usage_event_ids", "duration_ms"],
      "properties": {
        "contract": {"const": "attempt_outcome_v1"},
        "run_id": {"$ref": "#/$defs/executionIdentity"}, "stage_id": {"$ref": "#/$defs/executionIdentity"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "policy_version": {"const": "bounded-attempts-v1"}, "enforcement": {"const": "advisory"},
        "dispatch_event_id": {"$ref": "#/$defs/executionIdentity"},
        "result": {"enum": ["success", "failure", "partial", "cancelled", "unknown"]},
        "failure_class": {"enum": [null, "acceptance", "capability", "infrastructure", "authorization", "risk", "user_decision", "cancelled", "unknown"]},
        "first_feedback_event_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "test_event_ids": {"$ref": "#/$defs/executionEventReferences"}, "review_event_ids": {"$ref": "#/$defs/executionEventReferences"}, "usage_event_ids": {"$ref": "#/$defs/executionEventReferences"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"result": {"const": "success"}}}, "then": {"properties": {"failure_class": {"type": "null"}}}}]
    },
    "userChoicePayload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "choice": {"enum": ["accepted", "declined", "rejected", "modified", "unknown"]}, "accepted": {"type": "boolean"},
        "selected": {"type": ["object", "null"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 8192},
        "scores": {"$ref": "#/$defs/common/scores"}, "reason": {"$ref": "#/$defs/common/reason"}, "evidence_refs": {"$ref": "#/$defs/common/evidence_refs"}
      }
    },
    "runManifestNullableIdentity": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "runManifestPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_version", "run_id", "host_root_ref", "mode", "observed_at", "terminal_checkpoint", "context", "meter", "segments", "outcome_event_ids", "coverage"],
      "properties": {
        "manifest_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "host_root_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "mode": {"enum": ["baseline", "laya"]},
        "observed_at": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 512},
        "terminal_checkpoint": {"type": "string", "minLength": 1, "maxLength": 512},
        "context": {
          "type": "object", "additionalProperties": false,
          "required": ["task_snapshot_hash", "code_revision", "test_snapshot_hash", "tool_environment_id", "external_inputs_hash", "acceptance_policy"],
          "properties": {
            "task_snapshot_hash": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "code_revision": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "test_snapshot_hash": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "tool_environment_id": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "external_inputs_hash": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "acceptance_policy": {"$ref": "#/$defs/runManifestNullableIdentity"}
          }
        },
        "meter": {
          "type": "object", "additionalProperties": false,
          "required": ["unit", "identity", "scope", "excluded_components"],
          "properties": {
            "unit": {"const": "tokens"},
            "identity": {"$ref": "#/$defs/runManifestNullableIdentity"},
            "scope": {"const": "host_only"},
            "excluded_components": {"const": ["local_laya_inference"]}
          }
        },
        "segments": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_id", "attempt_ref", "usage_event_id"],
            "properties": {
              "decision_id": {"type": "string", "minLength": 1, "maxLength": 512},
              "attempt_ref": {"type": "string", "minLength": 1, "maxLength": 512},
              "usage_event_id": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        },
        "outcome_event_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "evidence_refs"],
          "properties": {
            "status": {"enum": ["complete", "partial", "unknown"]},
            "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
          }
        },
        "scenario": {"$ref": "#/$defs/runScenario"}
      }
    },
    "runScenario": {
      "type": "object", "additionalProperties": false,
      "required": ["orchestrator_model", "reasoning_effort", "initial_context_tokens", "stages", "input_source"],
      "properties": {
        "orchestrator_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "reasoning_effort": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "initial_context_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "stages": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["context_growth_tokens", "work_output_tokens", "passes"],
            "properties": {
              "context_growth_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "work_output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "passes": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }
        },
        "input_source": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "usagePayload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "source": {"type": "string", "minLength": 1, "maxLength": 1024}, "source_verified": {"type": "boolean"},
        "scope": {"enum": ["response", "turn", "attempt", "task", "subtree"]}, "checkpoint": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "parent_scope": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}, "overlap_status": {"enum": ["non_overlapping", "overlapping", "unknown"]},
        "aggregation": {"const": "cumulative"}, "usage_stream_id": {"type": "string", "minLength": 1, "maxLength": 128}, "source_sequence": {"type": "integer", "minimum": 1},
        "scores": {"$ref": "#/$defs/common/scores"}, "reason": {"$ref": "#/$defs/common/reason"}, "evidence_refs": {"$ref": "#/$defs/common/evidence_refs"}
      },
      "dependentRequired": {
        "aggregation": ["usage_stream_id", "source_sequence"],
        "usage_stream_id": ["aggregation", "source_sequence"],
        "source_sequence": ["aggregation", "usage_stream_id"]
      },
      "allOf": [{
        "if": {"anyOf": [
          {"required": ["total_tokens"], "properties": {"total_tokens": {"type": "integer"}}},
          {"required": ["input_tokens"], "properties": {"input_tokens": {"type": "integer"}}},
          {"required": ["output_tokens"], "properties": {"output_tokens": {"type": "integer"}}}
        ]},
        "then": {"required": ["source", "source_verified", "scope", "checkpoint", "overlap_status"], "properties": {"source_verified": {"const": true}}}
      }, {
        "if": {"required": ["usage_stream_id"]},
        "then": {"required": ["total_tokens", "source", "source_verified", "scope", "checkpoint", "overlap_status"], "properties": {"scope": {"const": "attempt"}}}
      }]
    }
  }
}
